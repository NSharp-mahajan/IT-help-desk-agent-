# Streamlit Secrets Configuration Template
# Copy this file to .streamlit/secrets.toml and fill in your Firebase project credentials.
# NEVER commit .streamlit/secrets.toml to version control.

[firebase]
api_key = "AIzaSy..."
auth_domain = "your-project-id.firebaseapp.com"
project_id = "your-project-id"
storage_bucket = "your-project-id.appspot.com"
messaging_sender_id = "123456789012"
app_id = "1:123456789012:web:abcdef1234567890"
